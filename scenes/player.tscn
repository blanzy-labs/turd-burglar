[sub_resource type="Shader" id="Shader_thorax_stripes"]
code = "shader_type spatial;
render_mode diffuse_lambert, specular_disabled;

uniform vec4 stripe_light : source_color = vec4(0.78, 0.71, 0.55, 1.0);
uniform vec4 stripe_dark : source_color = vec4(0.035, 0.025, 0.045, 1.0);
uniform float stripe_count : hint_range(3.0, 5.0, 1.0) = 5.0;

varying float shell_z;

void vertex() {
	shell_z = VERTEX.z;
}

void fragment() {
	float shell_position = clamp((shell_z + 0.38) / 0.76, 0.0, 0.9999);
	float band = floor(shell_position * stripe_count);
	float light_band = mod(band, 2.0);
	ALBEDO = mix(stripe_dark.rgb, stripe_light.rgb, light_band);
	ROUGHNESS = 0.96;
}"

